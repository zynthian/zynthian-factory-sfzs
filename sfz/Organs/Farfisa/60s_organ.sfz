<control>
// Tremolo controllers
label_cc1=Tremolo Amp
label_cc92=Tremolo Freq
set_hdcc1=0
set_hdcc92=0.5

<global>
// Tremolo
lfo01_wave=0              // Waveform shape (0 = Sine, 1 = Triangle)
// 1. Map the Mod Wheel (CC 1) to control the depth
lfo01_volume=0.0          // Base volume
lfo01_volume_oncc1=6.0    // Pushing the mod wheel all the way up adds 6 dB of volume modulation
// 2. Map CC92 to control the tremolo frequency
lfo01_freq=2            // Base frequency
lfo01_freq_oncc92=7       // Knob adds up to 7 Hz to the speed

global_volume=-2

<group>
	ampeg_hold=100
	ampeg_release=0.01
	pan=-100
<region>
	sample=3_Ab.flac
	pitch_keycenter=56
	lokey=0 hikey=57
<region>
	sample=4_C.flac
	pitch_keycenter=60
	lokey=58 hikey=61
<region>
	sample=4_Eb.flac
	pitch_keycenter=63
	lokey=62 hikey=64
<region>
	sample=4_Gb.flac
	pitch_keycenter=66
	lokey=65 hikey=67
<region>
	sample=4_A.flac
	pitch_keycenter=69
	lokey=68 hikey=70
<region>
	sample=5_C.flac
	pitch_keycenter=72
	lokey=71 hikey=73
<region>
	sample=5_Eb.flac
	pitch_keycenter=75
	lokey=74 hikey=76
<region>
	sample=5_Gb.flac
	pitch_keycenter=78
	lokey=77 hikey=79
<region>
	sample=5_A.flac
	pitch_keycenter=81
	lokey=80 hikey=82
<region>
	sample=6_C.flac
	pitch_keycenter=84
	lokey=83 hikey=85
<region>
	sample=6_E.flac
	pitch_keycenter=88
	lokey=86 hikey=90
<region>
	sample=6_A.flac
	pitch_keycenter=93
	lokey=91 hikey=127

<group>
	ampeg_hold=100
	ampeg_release=0.01
	pan=100
<region>
	sample=3_Ab_b.flac
	pitch_keycenter=56
	lokey=0 hikey=57
